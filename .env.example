# Free local generation: ollama, or local for evidence-only extractive answers
GENERATION_PROVIDER=ollama
OLLAMA_FAST_MODEL=qwen3:1.7b
OLLAMA_CHAT_MODEL=qwen3-vl:4b-instruct
LOCAL_ANSWER_MODEL=extractive-v1
LOCAL_ANSWER_FALLBACK=true
QUICK_MODE_LOCAL=true
BALANCED_MODE_LOCAL=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192
OLLAMA_AUTO_MODEL_FALLBACK=true
OLLAMA_WARMUP_ON_START=true
OLLAMA_WARMUP_TIMEOUT_SECONDS=90
OLLAMA_BALANCED_TIMEOUT_SECONDS=150
OLLAMA_DEEP_TIMEOUT_SECONDS=240
OLLAMA_QUEUE_TIMEOUT_SECONDS=2
OLLAMA_MAX_CONCURRENT_GENERATIONS=1
TEMPERATURE=0.1
MAX_ANSWER_TOKENS=900
GENERATION_TIMEOUT_SECONDS=240
BALANCED_CONTEXT_CHARACTERS=9000
DEEP_CONTEXT_CHARACTERS=10000
MAX_HISTORY_CHARACTERS=2400

# Free embeddings: local uses Chroma's ONNX all-MiniLM-L6-v2; ollama is optional
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=64

# Storage and limits
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_db
METADATA_DB=data/documents.sqlite3
EXTRACTION_CACHE_DIR=data/extractions
MAX_UPLOAD_SIZE_MB=100
MAX_PDF_PAGES=500
MAX_TOTAL_DOCUMENTS=1000
MAX_PAGE_CHARACTERS=250000
MAX_EXTRACTED_CHARACTERS=10000000
PDF_PREVIEW_DPI=144
PDF_PREVIEW_MAX_PIXELS=8000000

# OCR: auto, tesseract, ollama, or disabled
OCR_ENABLED=true
OCR_PROVIDER=auto
OCR_LANGUAGES=eng
TESSERACT_DATA_PATH=
OCR_DPI=300
OCR_MIN_TEXT_CHARACTERS=40
OCR_MAX_PAGES=500
OCR_MAX_IMAGE_PIXELS=20000000
OLLAMA_OCR_FALLBACK=true
OLLAMA_OCR_MODEL=qwen3-vl:4b-instruct
OLLAMA_OCR_MAX_OUTPUT_TOKENS=4000
OLLAMA_OCR_TIMEOUT_SECONDS=240
OCR_NATIVE_QUALITY_THRESHOLD=0.36
OCR_VISION_QUALITY_THRESHOLD=0.52
OCR_VISION_MAX_PAGES_PER_DOCUMENT=12
EXTRACT_TABLES=true

# Retrieval
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=75
DEFAULT_RETRIEVAL_K=8
MAX_RETRIEVAL_K=20
RETRIEVAL_CANDIDATE_MULTIPLIER=5
OVERVIEW_RETRIEVAL_K=12
MAX_VECTOR_DISTANCE=1.35
MIN_RETRIEVAL_RELEVANCE=0.12
HYBRID_SEARCH_ENABLED=true
HYBRID_MAX_CORPUS_CHUNKS=5000
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_ONNX_FILE=onnx/model.onnx
RERANKER_CACHE_DIR=data/models
RERANKER_AUTO_DOWNLOAD=true
RERANKER_MAX_CANDIDATES=24
RERANKER_MAX_LENGTH=384
RERANKER_BATCH_SIZE=8
RERANKER_WEIGHT=0.65
QUALITY_TRACKING_ENABLED=true
QUALITY_RECENT_RUN_LIMIT=200
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_HOURS=168
ANSWER_CACHE_MAX_ENTRIES=500
AUTO_RETRY_LEGACY_PROVIDER_FAILURES=true
AUTO_RETRY_INTERRUPTED_JOBS=true
MAX_CONCURRENT_INDEX_JOBS=1

LOG_DIR=logs
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_AUTH_TOKEN=
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
INDEX_RATE_LIMIT_PER_MINUTE=20
