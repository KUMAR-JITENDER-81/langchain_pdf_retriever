OPENAI_API_KEY=your-openai-api-key
GENERATION_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
OLLAMA_CHAT_MODEL=llama3.2:3b
TEMPERATURE=0.0
MAX_ANSWER_TOKENS=900
GENERATION_TIMEOUT_SECONDS=90

# Embeddings: openai or ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=64

# Storage and limits
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_db
METADATA_DB=data/documents.sqlite3
EXTRACTION_CACHE_DIR=data/extractions
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=300
MAX_TOTAL_DOCUMENTS=1000
MAX_PAGE_CHARACTERS=250000
MAX_EXTRACTED_CHARACTERS=5000000

# OCR: auto, tesseract, openai, or disabled
OCR_ENABLED=true
OCR_PROVIDER=auto
OCR_LANGUAGES=eng
TESSERACT_DATA_PATH=
OCR_DPI=300
OCR_MIN_TEXT_CHARACTERS=40
OCR_MAX_PAGES=300
OCR_MAX_IMAGE_PIXELS=20000000
OPENAI_OCR_FALLBACK=false
OPENAI_OCR_MODEL=gpt-4o-mini
OPENAI_OCR_MAX_OUTPUT_TOKENS=4000
EXTRACT_TABLES=true

# Retrieval
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=75
DEFAULT_RETRIEVAL_K=5
MAX_RETRIEVAL_K=20
RETRIEVAL_CANDIDATE_MULTIPLIER=3
MAX_VECTOR_DISTANCE=1.35
MIN_RETRIEVAL_RELEVANCE=0.12
HYBRID_SEARCH_ENABLED=true
HYBRID_MAX_CORPUS_CHUNKS=5000

LOG_DIR=logs
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_AUTH_TOKEN=
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
INDEX_RATE_LIMIT_PER_MINUTE=20
